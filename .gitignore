# Local environment and secret files
.env
.env.*
!.env.example
!.env.sample
!.env.template

# JVM output, logs and crash logs
*.class
*.log
hs_err_pid*
replay_pid*

# Build artifacts, except the Gradle wrapper, which must be committed
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle and Kotlin build state
.gradle/
build/
.kotlin/

# Node build state
node_modules/
.npm/
npm-debug.log*

# IntelliJ IDEA: only the files that are the same for everyone are shared
.idea/*
!.idea/.gitignore
!.idea/vcs.xml
*.iml
*.iws
/out/

# VS Code: only the shared settings are committed
.vscode/*
!.vscode/settings.json

# Eclipse and VS Code Java compile output
bin/

# Operating-system files
.DS_Store

# Git worktrees belong in ../worktrees-<repo name>/, never inside the checkout
/worktrees/

# TypeScript output
dist/
*.tsbuildinfo

# Scratch and validation projects
/tmp/

# Local notes that are never published
gradle-plugin-publishing.md
sedr-library-maven-central-publishing.md
/**/*prompts.md
